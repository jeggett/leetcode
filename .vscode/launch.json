{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Vitest: Current Problem",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "mise",
      "runtimeArgs": ["exec", "--", "node"],
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${fileDirname}"],
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Pytest: Current Problem",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${fileDirname}"],
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
