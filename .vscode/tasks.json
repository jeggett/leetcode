{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ready",
      "type": "process",
      "command": "mise",
      "args": ["exec", "--", "lc", "ready"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Format",
      "type": "process",
      "command": "mise",
      "args": ["exec", "--", "lc", "format"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Test: Current Problem",
      "type": "process",
      "command": "mise",
      "args": ["exec", "--", "lc", "test"],
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test: Current File",
      "type": "process",
      "command": "mise",
      "args": ["exec", "--", "lc", "test", "${file}"],
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Watch: Current TypeScript Problem",
      "type": "process",
      "command": "mise",
      "args": ["exec", "--", "lc", "watch"],
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Watch: Current Python Problem",
      "type": "process",
      "command": "mise",
      "args": ["exec", "--", "lc", "watch"],
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "New LeetCode Problem from URL",
      "type": "process",
      "command": "mise",
      "args": [
        "exec",
        "--",
        "lc",
        "start",
        "${input:problemLanguage}",
        "${input:problemUrl}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "New LeetCode Problem (Manual)",
      "type": "process",
      "command": "mise",
      "args": [
        "exec",
        "--",
        "lc",
        "new",
        "${input:problemLanguage}",
        "${input:problemNumber}",
        "${input:problemTitle}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "problemLanguage",
      "type": "pickString",
      "description": "Solution language",
      "options": ["ts", "py"],
      "default": "ts"
    },
    {
      "id": "problemUrl",
      "type": "promptString",
      "description": "LeetCode problem URL",
      "default": "https://leetcode.com/problems/two-sum/"
    },
    {
      "id": "problemNumber",
      "type": "promptString",
      "description": "LeetCode problem number",
      "default": "1"
    },
    {
      "id": "problemTitle",
      "type": "promptString",
      "description": "LeetCode problem title",
      "default": "Two Sum"
    }
  ]
}
