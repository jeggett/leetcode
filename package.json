{
  "name": "leetcode",
  "type": "module",
  "version": "1.0.0",
  "description": "Repo created to track progress on leetcode",
  "scripts": {
    "new": "uv run python -m scripts.new_problem",
    "submission": "uv run python -m scripts.submission",
    "test:one": "uv run python -m scripts.test_one",
    "test": "pnpm run test:ts && pnpm run test:py",
    "test:ts": "vitest run",
    "test:ts:watch": "vitest",
    "test:py": "uv run pytest",
    "incomplete": "uv run python -m scripts.check_incomplete",
    "lint": "pnpm run lint:ts && pnpm run lint:py",
    "lint:ts": "biome lint src/typescript scripts/*.mjs vitest.config.ts",
    "lint:py": "uv run ruff check .",
    "format": "pnpm run format:ts && pnpm run format:py",
    "format:ts": "biome format --write src/typescript scripts/*.mjs vitest.config.ts",
    "format:py": "uv run ruff format .",
    "format:check": "pnpm run format:check:ts && pnpm run format:check:py",
    "format:check:ts": "biome format src/typescript scripts/*.mjs vitest.config.ts",
    "format:check:py": "uv run ruff format --check .",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "judge:check": "uv run python -m scripts.check_judge && pnpm run judge:py",
    "judge:py": "uv run --isolated --frozen --python 3.14 pytest src/python",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run judge:check",
    "ready": "pnpm run incomplete && pnpm run check",
    "ready:all": "pnpm run ready",
    "doctor": "python -m scripts.doctor",
    "prepare": "python -m scripts.install_hooks"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jeggett/leetcode.git"
  },
  "keywords": [
    "leetcode"
  ],
  "author": "Alexander Zaytsev",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jeggett/leetcode/issues"
  },
  "homepage": "https://github.com/jeggett/leetcode#readme",
  "engines": {
    "node": ">=26.13.0",
    "pnpm": "12.16.1"
  },
  "devDependencies": {
    "@babel/parser": "8.0.10",
    "@biomejs/biome": "2.6.4",
    "lefthook": "2.2.2",
    "typescript": "7.0.2",
    "typescript-judge": "npm:typescript@5.7.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.16.1"
}
