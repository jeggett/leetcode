{
  "name": "leetcode",
  "type": "module",
  "version": "1.0.0",
  "description": "Repo created to track progress on leetcode",
  "scripts": {
    "new": "uv run python scripts/new_problem.py",
    "submission": "uv run python scripts/submission.py",
    "test:one": "uv run python scripts/test_one.py",
    "test": "pnpm run test:ts && pnpm run test:py",
    "test:ts": "vitest run",
    "test:ts:watch": "vitest",
    "test:py": "uv run pytest",
    "incomplete": "uv run python scripts/check_incomplete.py",
    "lint": "pnpm run lint:ts && pnpm run lint:py",
    "lint:ts": "biome lint src/typescript vitest.config.ts",
    "lint:py": "uv run ruff check .",
    "format": "pnpm run format:ts && pnpm run format:py",
    "format:ts": "biome format --write src/typescript vitest.config.ts",
    "format:py": "uv run ruff format .",
    "format:check": "pnpm run format:check:ts && pnpm run format:check:py",
    "format:check:ts": "biome format src/typescript vitest.config.ts",
    "format:check:py": "uv run ruff format --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "ready": "pnpm run incomplete && pnpm run check",
    "doctor": "mise exec -- python scripts/doctor.py",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jeggett/leetcode.git"
  },
  "keywords": [
    "leetcode"
  ],
  "author": "Alexander Zaytsev",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jeggett/leetcode/issues"
  },
  "homepage": "https://github.com/jeggett/leetcode#readme",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "11.20.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "husky": "9.1.7",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.20.0"
}
