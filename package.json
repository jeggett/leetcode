{
  "name": "leetcode",
  "type": "module",
  "version": "1.0.0",
  "description": "Repo created to track progress on leetcode",
  "scripts": {
    "new": "uv run python scripts/new_problem.py",
    "submission": "uv run python scripts/submission.py",
    "test:one": "uv run python scripts/test_one.py",
    "test": "pnpm run test:ts && pnpm run test:py",
    "test:ts": "vitest run",
    "test:ts:watch": "vitest",
    "test:py": "uv run pytest",
    "test:py:solutions": "uv run pytest src/python",
    "test:py:tools": "uv run pytest tests",
    "test:py:watch": "uv run ptw . --runner 'pytest --capture=sys' --now",
    "incomplete": "uv run python scripts/check_incomplete.py",
    "metadata": "uv run python scripts/ready.py metadata",
    "lint": "pnpm run lint:ts && pnpm run lint:py",
    "lint:ts": "biome lint src/typescript vitest.config.ts vitest.retry.config.ts",
    "lint:py": "uv run ruff check .",
    "format": "pnpm run format:ts && pnpm run format:py",
    "format:ts": "biome format --write src/typescript vitest.config.ts vitest.retry.config.ts",
    "format:py": "uv run ruff format .",
    "format:check": "pnpm run format:check:ts && pnpm run format:check:py",
    "format:check:ts": "biome format src/typescript vitest.config.ts vitest.retry.config.ts",
    "format:check:py": "uv run ruff format --check .",
    "typecheck": "tsc --noEmit",
    "compat": "uv run python scripts/compat.py && pnpm run typecheck",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "ready": "pnpm run ready:all",
    "ready:all": "pnpm run incomplete && pnpm run metadata && pnpm run format:check && pnpm run lint && pnpm run test && pnpm run compat",
    "ready:changed": "uv run python scripts/ready.py changed",
    "practice": "uv run python scripts/practice.py",
    "doctor": "python scripts/doctor.py",
    "prepare": "python scripts/install_hooks.py"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jeggett/leetcode.git"
  },
  "keywords": [
    "leetcode"
  ],
  "author": "Alexander Zaytsev",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jeggett/leetcode/issues"
  },
  "homepage": "https://github.com/jeggett/leetcode#readme",
  "engines": {
    "node": ">=26.7.0",
    "pnpm": "11.20.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "lefthook": "2.1.10",
    "typescript": "5.7.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.20.0"
}
